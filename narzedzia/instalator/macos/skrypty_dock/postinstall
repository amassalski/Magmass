#!/bin/bash
# Dodaje Magmass do Docka zalogowanego użytkownika. Instalator działa jako root, więc zapis musi iść w kontekście użytkownika.
# Błąd tego kroku nigdy nie przerywa instalacji (zawsze exit 0).
APP="/Applications/Magmass.app"
[ -d "$APP" ] || exit 0
UZYTKOWNIK="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
if [ -z "$UZYTKOWNIK" ] || [ "$UZYTKOWNIK" = "root" ] || [ "$UZYTKOWNIK" = "loginwindow" ]; then exit 0; fi
UID_UZ="$(/usr/bin/id -u "$UZYTKOWNIK" 2>/dev/null)"
[ -n "$UID_UZ" ] || exit 0
JAKO() { /bin/launchctl asuser "$UID_UZ" /usr/bin/sudo -u "$UZYTKOWNIK" "$@"; }

# już jest w Docku: nic nie dodajemy
if JAKO /usr/bin/defaults read com.apple.dock persistent-apps 2>/dev/null | /usr/bin/grep -q "Magmass.app"; then exit 0; fi

JAKO /usr/bin/defaults write com.apple.dock persistent-apps -array-add \
  "<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>$APP</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>" 2>/dev/null
/usr/bin/killall Dock 2>/dev/null
exit 0
