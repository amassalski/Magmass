msgstr "Cathode capacitor: at least "

#: src/GUI/DialogAudioLampy.cpp:1026
msgid "Niemożliwe: Ug musi być ujemne, a spadek na Ra mniejszy od B+."
msgstr "Impossible: Vg must be negative, and the drop across Ra less than B+."

#: src/GUI/DialogCewkiAL.cpp:15
msgid "Cewka na rdzeniu z AL"
msgstr "Coil on a core with AL"

#: src/GUI/DialogCewkiAL.cpp:19 src/GUI/DialogElementu.cpp:137
