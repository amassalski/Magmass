#: src/GUI/DialogAudioLampy.cpp:833
msgid ""
"Elementy RC biernej sieci korekcyjnej (odtwarzanie): sekcja A = R1 || C1 w "
"szeregu i R2 || C2 do masy (3180/318 µs), sekcja B = R3 szeregowo i C3 do "
"masy (75 µs); sekcje rozdziela stopień wzmacniający."
msgstr ""
"RC elements of the passive equalization network (playback): section A = R1 "
"|| C1 in series and R2 || C2 to ground (3180/318 µs), section B = series R3 "
"and C3 to ground (75 µs); the sections are separated by an amplifying stage."

#: src/GUI/DialogAudioLampy.cpp:842
msgid "rezystory z szeregu"
msgstr "resistors from series"

#: src/GUI/DialogAudioLampy.cpp:846
msgid "kondensatory"
msgstr "capacitors"

#: src/GUI/DialogAudioLampy.cpp:868
msgid "Wpisz częstotliwość większą od zera."
msgstr "Enter a frequency greater than zero."

#: src/GUI/DialogAudioLampy.cpp:871
msgid "(względem 1 kHz)"
msgstr "(relative to 1 kHz)"

#: src/GUI/DialogAudioLampy.cpp:886
msgid "Podaj zakres i dodatni interwał."
msgstr "Enter a range and a positive step."

#: src/GUI/DialogAudioLampy.cpp:886
#, c-format
msgid "Punktów: %zu"
msgstr "Points: %zu"

